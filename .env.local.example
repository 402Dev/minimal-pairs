# Supabase configuration. If either of these is missing, the app falls
# back to local disk storage (public/uploads) and a local SQLite database
# (dev.db) automatically — no changes needed for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key, used only server-side by the hidden /admin panel to
# bypass Row Level Security for CRUD operations. Never expose this to the
# browser (no NEXT_PUBLIC_ prefix). Find it in Supabase dashboard ->
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the hidden /admin panel. If unset, /admin shows a "not
# configured" message instead of a login form. Pick something long and
# random; the panel has full read/write/delete access to all data.
ADMIN_PASSWORD=Elena
